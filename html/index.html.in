<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="ROBOTS" content="NOINDEX, NOFOLLOW">
	<title>Nagios Core</title>
	<link rel="shortcut icon" href="images/favicon.ico" type="image/ico">
	<link rel="stylesheet" type="text/css" href="stylesheets/common.css?4.4.14">
	<link rel="stylesheet" type="text/css" href="stylesheets/status.css?4.4.14">
	<!-- nagios-app.css/nagios-app.js change on every al2023-4.4.14-kuriyamaN
	     release (unlike common.css/status.css, which only change with the
	     underlying nagios core version); this query string is bumped by
	     hand alongside that release number to bust caches -- a stale copy
	     of either was reported as looking like an old release's fixes
	     hadn't taken effect. See README.md for the release checklist. -->
	<link rel="stylesheet" type="text/css" href="stylesheets/nagios-app.css?kuriyama40">

	<script LANGUAGE="javascript">
		// Other CGI-rendered pages (status.cgi, extinfo.cgi, cmd.cgi's own
		// forms) still rely on this cookie for their weak CSRF double-submit
		// check on command submission, even though this SPA itself doesn't
		// submit to cmd.cgi. Keep setting it so those pages aren't
		// regressed just because this is no longer index.php.
		var n = Math.round(Math.random() * 10000000000);
		document.cookie = "NagFormId=" + n.toString(16);

		window.NAGIOS_CGI_URL = "@cgiurl@";
		window.NAGIOS_HTML_URL = "@htmurl@";
	</script>
</head>

<body id="splashpage">
	<div id="nav"></div>
	<div id="dashboard"></div>

	<script type="text/javascript" src="js/nagios-app.js?kuriyama40"></script>
</body>
</html>
